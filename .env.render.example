# Render environment variables
# Fill these in Render Dashboard > Environment.

DB_HOST=your-aiven-mysql-host
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL_CA=ca.pem

JWT_SECRET=replace-with-a-long-random-secret
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Keep true only while creating the first admin account.
ALLOW_DEBUG_ROUTES=true

# Optional. Only enable Firebase if the credential file is deployed safely.
# GOOGLE_APPLICATION_CREDENTIALS=firebase_service_account.json
